{
  "version": 1,
  "id": "civic-recovery",
  "title": "Civic recovery (synthetic)",
  "groups": [
    {
      "id": "services",
      "title": "Public services",
      "scenarios": [
        {
          "id": "service-restoration",
          "title": "Service restoration",
          "scope": "Municipal",
          "file": "service-restoration.json"
        },
        {
