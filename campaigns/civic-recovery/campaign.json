          }
        }
      ]
    },
    {
      "id": "coordination",
      "title": "Civic coordination",
      "scenarios": [
        {
          "id": "civic-agreement",
          "title": "Civic agreement",
          "scope": "Intermunicipal",
          "file": "civic-agreement.json",
          "prerequisites": [
            "community-assistance"
          ],
          "carry_from": {
            "scenario": "community-assistance",
            "variables": {
              "households_assisted": "households_assisted"
            }
          }
        }
      ]
    }
  ]
