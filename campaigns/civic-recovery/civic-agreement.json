{
  "version": 1,
  "id": "civic-agreement",
  "turn_minutes": 360,
  "end_minute": 720,
  "initial": {
    "participating_councils": 0,
    "council_a_joined": 0,
    "council_b_joined": 0,
    "households_assisted": 0
  },
  "events": [],
  "constraints": [],
  "actors": {
    "council_a": {
      "label": "Council A",
      "visible_keys": [
        "participating_councils",
        "council_a_joined",
        "households_assisted"
      ],
      "objectives": {
        "agreement": {
          "description": "Both councils participate",
          "key": "participating_councils",
          "comparison": "at_least",
          "threshold": 2
        }
      }
    },
    "council_b": {
      "label": "Council B",
      "visible_keys": [
        "participating_councils",
        "council_b_joined",
        "households_assisted"
      ],
      "objectives": {
        "consent": {
          "description": "Council B independently consents",
          "key": "council_b_joined",
          "comparison": "equal",
          "threshold": 1
        }
      }
    }
  },
  "civic_agreement": true,
  "administrative_reviews_per_turn": 2,
  "action_catalog": {
    "join_council_a": {
      "description": "Council A consents to the agreement",
      "actors": [
        "council_a"
      ]
    },
    "join_council_b": {
      "description": "Council B consents to the agreement",
      "actors": [
        "council_b"
      ]
    }
  }
}
