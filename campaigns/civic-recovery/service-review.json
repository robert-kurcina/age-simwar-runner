{
  "version": 1,
  "id": "service-review",
  "turn_minutes": 360,
  "end_minute": 360,
  "initial": {
    "reports_received": 0,
    "review_capacity": 1,
    "reports_assessed": 0
  },
  "events": [
    {
      "id": "report",
      "minute": 360,
      "key": "reports_received",
      "delta": 1
    }
  ],
  "constraints": [],
  "actors": {
    "reviewer": {
      "label": "Service reviewer",
      "visible_keys": [
        "reports_received",
        "review_capacity",
        "reports_assessed"
      ],
      "objectives": {
        "report": {
          "description": "Receive one service report",
          "key": "reports_received",
          "comparison": "at_least",
          "threshold": 1
        },
        "assessment": {
          "description": "Assess the received service report",
          "key": "reports_assessed",
          "comparison": "at_least",
          "threshold": 1
        }
      }
    }
  },
  "dependent_events": [
    {
      "id": "assess-report",
      "minute": 360,
      "participant": "reviewer",
      "requires": [
        {
          "key": "reports_received",
          "at_least": 1
        },
        {
          "key": "review_capacity",
          "at_least": 1
        }
      ],
      "updates": {
        "review_capacity": -1,
        "reports_assessed": 1
      }
    }
  ]
}
