{
  "version": 1,
  "id": "library-reopening",
  "turn_minutes": 360,
  "end_minute": 720,
  "initial": {
    "available_rooms": 0,
    "inspection_notes": 1
  },
  "events": [
    {
      "id": "inspection",
      "minute": 60,
      "key": "available_rooms",
      "delta": 2
    },
    {
      "id": "reopening",
      "minute": 360,
      "key": "available_rooms",
      "delta": 3
    }
  ],
  "constraints": [
    {
      "minute": 60,
      "key": "available_rooms",
      "equals": 2
    },
    {
      "minute": 360,
      "key": "available_rooms",
      "equals": 5
    }
  ],
  "actors": {
    "library": {
      "label": "Library administration",
      "objectives": {
        "access": {
          "description": "Restore five available rooms",
          "key": "available_rooms",
          "comparison": "at_least",
          "threshold": 5
        }
      },
      "visible_keys": [
        "available_rooms"
      ],
      "report_delay_minutes": {
        "available_rooms": 60
      }
    },
    "maintenance": {
      "label": "Maintenance department",
      "objectives": {
        "inspection": {
          "description": "Keep at least two rooms available",
          "key": "available_rooms",
          "comparison": "at_least",
          "threshold": 2
        }
      },
      "visible_keys": [
        "available_rooms",
        "inspection_notes"
      ]
    }
  },
  "action_catalog": {
    "request_room_inspection": {
      "description": "Request a room inspection",
      "actors": [
        "library",
        "maintenance"
      ]
    },
    "request_maintenance_review": {
      "description": "Request an administrative maintenance review",
      "actors": [
        "maintenance"
      ]
    }
  },
  "administrative_reviews_per_turn": 1
}
